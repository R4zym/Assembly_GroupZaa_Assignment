 00000000			.code

				; =========================================================================
				; MAIN PROCEDURE
				; =========================================================================
 00000000			main PROC
 00000000  55			    push ebp
 00000001  8B EC		    mov  ebp, esp

				    ; 1. รับค่า Key จาก Console
 00000003  BA 00000000 R	    mov  edx, OFFSET promptKey
 00000008  E8 00000000 E	    call WriteString

 0000000D  BA 00000147 R	    mov  edx, OFFSET keyInput
 00000012  B9 0000003F		    mov  ecx, SIZEOF keyInput - 1
 00000017  E8 00000000 E	    call ReadString

				    ; 2. แปลง Hex string เป็น 8-byte Binary
 0000001C  68 00000187 R	    push OFFSET Key64
 00000021  68 00000147 R	    push OFFSET keyInput
 00000026  E8 00000231		    call ParseAndConvertHex
 0000002B  83 F8 01		    cmp  eax, 1
 0000002E  75 3E		    jne  InvalidKey

				    ; 3. ตรวจสอบ Parity ตามมาตรฐาน FIPS 46-3
 00000030  68 00000187 R	    push OFFSET Key64
 00000035  E8 000001F6		    call ValidateKeyParity
 0000003A  83 F8 01		    cmp  eax, 1
 0000003D  74 0A		    je   ParityValid
 0000003F  BA 000000BC R	    mov  edx, OFFSET msgParityWarn
 00000044  E8 00000000 E	    call WriteString

 00000049			ParityValid:
 00000049  BA 00000040 R	    mov  edx, OFFSET msgOK
 0000004E  E8 00000000 E	    call WriteString

				    ; 4. คำนวณ Key Schedule 16 รอบ
 00000053  68 0000018F R	    push OFFSET SubKeys
 00000058  68 00000187 R	    push OFFSET Key64
 0000005D  E8 00000020		    call GenerateKeySchedule

				    ; 5. แสดงผล C0, D0 และ Subkeys K1 - K16
 00000062  68 0000018F R	    push OFFSET SubKeys
 00000067  E8 000002D8		    call DisplayAllSubKeys

 0000006C  EB 0A		    jmp  ProgramExit

 0000006E			InvalidKey:
 0000006E  BA 00000075 R	    mov  edx, OFFSET msgErr
 00000073  E8 00000000 E	    call WriteString

 00000078			ProgramExit:
 00000078  8B E5		    mov  esp, ebp
 0000007A  5D			    pop  ebp
				    exit
 0000007B  6A 00	   *	    push   +000000000h
 0000007D  E8 00000000 E   *	    call   ExitProcess
 00000082			main ENDP


				; =========================================================================
				; GenerateKeySchedule
				; Parameters:
				;   [ebp + 8]  = Pointer ไปยัง 64-bit Key (8 bytes)
				;   [ebp + 12] = Pointer ไปยัง Subkeys Buffer (96 bytes)
				; Returns: EAX = 1 (Success)
				; =========================================================================
 00000082			GenerateKeySchedule PROC
 00000082  55			    push ebp
 00000083  8B EC		    mov  ebp, esp
 00000085  53			    push ebx
 00000086  51			    push ecx
 00000087  52			    push edx
 00000088  56			    push esi
 00000089  57			    push edi

 0000008A  8B 75 08		    mov  esi, [ebp + 8]        ; pKey64
 0000008D  8B 7D 0C		    mov  edi, [ebp + 12]       ; pSubKeysOut

				    ; ขั้นตอนที่ 1: ทำ PC-1 เพื่อสร้าง C0 และ D0
 00000090  56			    push esi
 00000091  E8 00000065		    call GenerateC0D0

				    ; สำรองค่า C0, D0 เริ่มต้นไว้สำหรับการแสดงผลหรือ Verification
 00000096  A1 000001EF R	    mov  eax, C_Val
 0000009B  A3 000001F7 R	    mov  C0_Init, eax
 000000A0  A1 000001F3 R	    mov  eax, D_Val
 000000A5  A3 000001FB R	    mov  D0_Init, eax

				    ; ขั้นตอนที่ 2: วนลูป 16 รอบเพื่อสร้าง Ki
 000000AA  33 DB		    xor  ebx, ebx              ; ebx = Round index (0 ถึง 15)

 000000AC			RoundLoop:
 000000AC  83 FB 10		    cmp  ebx, 16
 000000AF  7D 3A		    jge  KeyGenFinished

 000000B1  0F B6 8B		    movzx ecx, BYTE PTR ShiftSchedule[ebx]
	   00000237 R

				    ; Circular Rotate Left C_Val
 000000B8  A1 000001EF R	    mov  eax, C_Val
 000000BD  51			    push ecx
 000000BE  50			    push eax
 000000BF  E8 00000084		    call Rotate28
 000000C4  A3 000001EF R	    mov  C_Val, eax

				    ; Circular Rotate Left D_Val
 000000C9  A1 000001F3 R	    mov  eax, D_Val
 000000CE  51			    push ecx
 000000CF  50			    push eax
 000000D0  E8 00000073		    call Rotate28
 000000D5  A3 000001F3 R	    mov  D_Val, eax

				    ; หาตำแหน่ง Buffer: pSubKeysOut + (round * 6)
 000000DA  8B C3		    mov  eax, ebx
 000000DC  6B C0 06		    imul eax, 6
 000000DF  8D 14 07		    lea  edx, [edi + eax]

				    ; ทำ PC-2 สร้าง 48-bit Subkey ลงในรอบปัจจุบัน
 000000E2  52			    push edx
 000000E3  E8 00000091		    call GenerateSubKeyPC2

 000000E8  43			    inc  ebx
 000000E9  EB C1		    jmp  RoundLoop

 000000EB			KeyGenFinished:
 000000EB  5F			    pop  edi
 000000EC  5E			    pop  esi
 000000ED  5A			    pop  edx
 000000EE  59			    pop  ecx
 000000EF  5B			    pop  ebx
 000000F0  B8 00000001		    mov  eax, 1
 000000F5  8B E5		    mov  esp, ebp
 000000F7  5D			    pop  ebp
 000000F8  C2 0008		    ret  8
 000000FB			GenerateKeySchedule ENDP


				; =========================================================================
				; GenerateC0D0
				; ดำเนินการ Permuted Choice 1 (PC-1)
				; Parameters: [ebp + 8] = Pointer to 8-byte Key
				; =========================================================================
 000000FB			GenerateC0D0 PROC
 000000FB  55			    push ebp
 000000FC  8B EC		    mov  ebp, esp
 000000FE  53			    push ebx
 000000FF  51			    push ecx
 00000100  52			    push edx
 00000101  56			    push esi
 00000102  57			    push edi

 00000103  8B 75 08		    mov  esi, [ebp + 8]
 00000106  33 FF		    xor  edi, edi              ; C accumulator (28-bit)
 00000108  33 DB		    xor  ebx, ebx              ; D accumulator (28-bit)
 0000010A  33 D2		    xor  edx, edx              ; Index (0 ถึง 55)

 0000010C			PC1_Loop:
 0000010C  83 FA 38		    cmp  edx, 56
 0000010F  7D 20		    jge  PC1_Done

 00000111  0F B6 8A		    movzx ecx, BYTE PTR PC1[edx]
	   000001FF R

 00000118  51			    push ecx
 00000119  56			    push esi
 0000011A  E8 000000DF		    call GetBit64

 0000011F  83 FA 1C		    cmp  edx, 28
 00000122  7D 06		    jge  PutIntoD

 00000124  D1 E7		    shl  edi, 1
 00000126  0B F8		    or   edi, eax
 00000128  EB 04		    jmp  PC1_Next

 0000012A			PutIntoD:
 0000012A  D1 E3		    shl  ebx, 1
 0000012C  0B D8		    or   ebx, eax

 0000012E			PC1_Next:
 0000012E  42			    inc  edx
 0000012F  EB DB		    jmp  PC1_Loop

 00000131			PC1_Done:
 00000131  89 3D 000001EF R	    mov  C_Val, edi
 00000137  89 1D 000001F3 R	    mov  D_Val, ebx

 0000013D  5F			    pop  edi
 0000013E  5E			    pop  esi
 0000013F  5A			    pop  edx
 00000140  59			    pop  ecx
 00000141  5B			    pop  ebx
 00000142  8B E5		    mov  esp, ebp
 00000144  5D			    pop  ebp
 00000145  C2 0004		    ret  4
 00000148			GenerateC0D0 ENDP


				; =========================================================================
				; Rotate28 (28-bit Circular Shift Left)
				; Parameters:
				;   [ebp + 8]  = ค่า 28-bit
				;   [ebp + 12] = จำนวนบิตที่จะหมุน (1 หรือ 2)
				; =========================================================================
 00000148			Rotate28 PROC
 00000148  55			    push ebp
 00000149  8B EC		    mov  ebp, esp
 0000014B  53			    push ebx
 0000014C  51			    push ecx

 0000014D  8B 45 08		    mov  eax, [ebp + 8]
 00000150  25 0FFFFFFF		    and  eax, 0FFFFFFFh
 00000155  8B 4D 0C		    mov  ecx, [ebp + 12]

 00000158			RotateLoop:
 00000158  83 F9 00		    cmp  ecx, 0
 0000015B  7E 14		    jle  RotateDone

 0000015D  8B D8		    mov  ebx, eax
 0000015F  C1 EB 1B		    shr  ebx, 27
 00000162  83 E3 01		    and  ebx, 1

 00000165  D1 E0		    shl  eax, 1
 00000167  25 0FFFFFFF		    and  eax, 0FFFFFFFh
 0000016C  0B C3		    or   eax, ebx

 0000016E  49			    dec  ecx
 0000016F  EB E7		    jmp  RotateLoop

 00000171			RotateDone:
 00000171  59			    pop  ecx
 00000172  5B			    pop  ebx
 00000173  8B E5		    mov  esp, ebp
 00000175  5D			    pop  ebp
 00000176  C2 0008		    ret  8
 00000179			Rotate28 ENDP


				; =========================================================================
				; GenerateSubKeyPC2
				; ดำเนินการ Permuted Choice 2 (PC-2) 48 bits
				; Parameters: [ebp + 8] = Destination Pointer (6 bytes)
				; =========================================================================
 00000179			GenerateSubKeyPC2 PROC
 00000179  55			    push ebp
 0000017A  8B EC		    mov  ebp, esp
 0000017C  50			    push eax
 0000017D  53			    push ebx
 0000017E  51			    push ecx
 0000017F  52			    push edx
 00000180  57			    push edi

 00000181  8B 7D 08		    mov  edi, [ebp + 8]
 00000184  33 DB		    xor  ebx, ebx              ; Byte accumulator
 00000186  33 C9		    xor  ecx, ecx              ; Byte counter (0 ถึง 5)
 00000188  33 D2		    xor  edx, edx              ; PC2 table counter (0 ถึง 47)

 0000018A			PC2_Loop:
 0000018A  83 FA 30		    cmp  edx, 48
 0000018D  7D 24		    jge  PC2_Done

 0000018F  0F B6 82		    movzx eax, BYTE PTR PC2[edx]
	   00000247 R
 00000196  50			    push eax
 00000197  E8 00000022		    call GetBitCD

 0000019C  D1 E3		    shl  ebx, 1
 0000019E  0B D8		    or   ebx, eax
 000001A0  42			    inc  edx

				    ; เก็บข้อมูลลง Buffer ทุกๆ 8 บิต
 000001A1  8B C2		    mov  eax, edx
 000001A3  83 E0 07		    and  eax, 7
 000001A6  83 F8 00		    cmp  eax, 0
 000001A9  75 DF		    jne  PC2_Loop

 000001AB  88 1C 0F		    mov  BYTE PTR [edi + ecx], bl
 000001AE  41			    inc  ecx
 000001AF  33 DB		    xor  ebx, ebx
 000001B1  EB D7		    jmp  PC2_Loop

 000001B3			PC2_Done:
 000001B3  5F			    pop  edi
 000001B4  5A			    pop  edx
 000001B5  59			    pop  ecx
 000001B6  5B			    pop  ebx
 000001B7  58			    pop  eax
 000001B8  8B E5		    mov  esp, ebp
 000001BA  5D			    pop  ebp
 000001BB  C2 0004		    ret  4
 000001BE			GenerateSubKeyPC2 ENDP


				; =========================================================================
				; GetBitCD
				; Parameters: [ebp + 8] = ตำแหน่งบิต (1-56)
				; Returns: EAX = ค่าบิต (0 หรือ 1)
				; =========================================================================
 000001BE			GetBitCD PROC
 000001BE  55			    push ebp
 000001BF  8B EC		    mov  ebp, esp
 000001C1  51			    push ecx
 000001C2  52			    push edx

 000001C3  8B 4D 08		    mov  ecx, [ebp + 8]
 000001C6  83 F9 1C		    cmp  ecx, 28
 000001C9  7F 15		    jg   ReadFromD

 000001CB  A1 000001EF R	    mov  eax, C_Val
 000001D0  BA 0000001C		    mov  edx, 28
 000001D5  2B D1		    sub  edx, ecx
 000001D7  8A CA		    mov  cl, dl
 000001D9  D3 E8		    shr  eax, cl
 000001DB  83 E0 01		    and  eax, 1
 000001DE  EB 16		    jmp  BitCD_Exit

 000001E0			ReadFromD:
 000001E0  A1 000001F3 R	    mov  eax, D_Val
 000001E5  83 E9 1C		    sub  ecx, 28
 000001E8  BA 0000001C		    mov  edx, 28
 000001ED  2B D1		    sub  edx, ecx
 000001EF  8A CA		    mov  cl, dl
 000001F1  D3 E8		    shr  eax, cl
 000001F3  83 E0 01		    and  eax, 1

 000001F6			BitCD_Exit:
 000001F6  5A			    pop  edx
 000001F7  59			    pop  ecx
 000001F8  8B E5		    mov  esp, ebp
 000001FA  5D			    pop  ebp
 000001FB  C2 0004		    ret  4
 000001FE			GetBitCD ENDP


				; =========================================================================
				; GetBit64
				; Parameters:
				;   [ebp + 8]  = Pointer to 8-byte Key
				;   [ebp + 12] = ตำแหน่งบิตตามมาตรฐาน FIPS (1 ถึง 64)
				; Returns: EAX = ค่าบิต (0 หรือ 1)
				; =========================================================================
 000001FE			GetBit64 PROC
 000001FE  55			    push ebp
 000001FF  8B EC		    mov  ebp, esp
 00000201  53			    push ebx
 00000202  51			    push ecx
 00000203  52			    push edx
 00000204  56			    push esi

 00000205  8B 75 08		    mov  esi, [ebp + 8]
 00000208  8B 45 0C		    mov  eax, [ebp + 12]
 0000020B  48			    dec  eax                   ; แปลงเป็น 0-indexed (0 ถึง 63)

 0000020C  8B D8		    mov  ebx, eax
 0000020E  C1 EB 03		    shr  ebx, 3                ; Byte index (0 ถึง 7)

 00000211  83 E0 07		    and  eax, 7                ; Bit offset ภายในไบต์
 00000214  BA 00000007		    mov  edx, 7
 00000219  2B D0		    sub  edx, eax              ; กลับด้านเพื่อให้ MSB คือ Bit 0 ตามหลัก Big-Endian
 0000021B  8A CA		    mov  cl, dl

 0000021D  0F B6 04 1E		    movzx eax, BYTE PTR [esi + ebx]
 00000221  D3 E8		    shr  eax, cl
 00000223  83 E0 01		    and  eax, 1

 00000226  5E			    pop  esi
 00000227  5A			    pop  edx
 00000228  59			    pop  ecx
 00000229  5B			    pop  ebx
 0000022A  8B E5		    mov  esp, ebp
 0000022C  5D			    pop  ebp
 0000022D  C2 0008		    ret  8
 00000230			GetBit64 ENDP


				; =========================================================================
				; ValidateKeyParity (FIPS 46-3 Check)
				; ตรวจสอบว่าทั้ง 8 ไบต์ มีจำนวนบิต 1 เป็นเลขคี่หรือไม่
				; Parameters: [ebp + 8] = Pointer to 8-byte Key
				; Returns: EAX = 1 (Valid Parity), 0 (Invalid Parity)
				; =========================================================================
 00000230			ValidateKeyParity PROC
 00000230  55			    push ebp
 00000231  8B EC		    mov  ebp, esp
 00000233  53			    push ebx
 00000234  51			    push ecx
 00000235  56			    push esi

 00000236  8B 75 08		    mov  esi, [ebp + 8]
 00000239  33 C9		    xor  ecx, ecx

 0000023B			CheckByteParity:
 0000023B  83 F9 08		    cmp  ecx, 8
 0000023E  7D 0A		    jge  ParityPassed

 00000240  8A 04 0E		    mov  al, BYTE PTR [esi + ecx]
 00000243  84 C0		    test al, al                ; คำนวณ Parity Flag บน AL
 00000245  7A 0A		    jp   ParityFailed          ; ใน x86: ถ้า PF=1 แสดงว่าเป็น Even Parity (ผิดกฎ FIPS)

 00000247  41			    inc  ecx
 00000248  EB F1		    jmp  CheckByteParity

 0000024A			ParityPassed:
 0000024A  B8 00000001		    mov  eax, 1
 0000024F  EB 02		    jmp  ParityExit

 00000251			ParityFailed:
 00000251  33 C0		    xor  eax, eax

 00000253			ParityExit:
 00000253  5E			    pop  esi
 00000254  59			    pop  ecx
 00000255  5B			    pop  ebx
 00000256  8B E5		    mov  esp, ebp
 00000258  5D			    pop  ebp
 00000259  C2 0004		    ret  4
 0000025C			ValidateKeyParity ENDP


				; =========================================================================
				; ParseAndConvertHex
				; Parameters:
				;   [ebp + 8]  = Pointer ไปยัง String Input
				;   [ebp + 12] = Pointer ไปยัง Buffer รับข้อมูล 8 ไบต์
				; Returns: EAX = 1 (สำเร็จ), 0 (รูปแบบผิดพลาด)
				; =========================================================================
 0000025C			ParseAndConvertHex PROC
 0000025C  55			    push ebp
 0000025D  8B EC		    mov  ebp, esp
 0000025F  53			    push ebx
 00000260  51			    push ecx
 00000261  52			    push edx
 00000262  56			    push esi
 00000263  57			    push edi

 00000264  8B 75 08		    mov  esi, [ebp + 8]
 00000267  8B 7D 0C		    mov  edi, [ebp + 12]

				    ; ข้าม Prefix "0x" หรือ "0X"
 0000026A  80 3E 30		    cmp  BYTE PTR [esi], '0'
 0000026D  75 0F		    jne  StartParsing
 0000026F  80 7E 01 78		    cmp  BYTE PTR [esi + 1], 'x'
 00000273  74 06		    je   SkipPrefix
 00000275  80 7E 01 58		    cmp  BYTE PTR [esi + 1], 'X'
 00000279  75 03		    jne  StartParsing

 0000027B			SkipPrefix:
 0000027B  83 C6 02		    add  esi, 2

 0000027E			StartParsing:
 0000027E  33 C9		    xor  ecx, ecx
 00000280			CountLength:
 00000280  80 3C 0E 00		    cmp  BYTE PTR [esi + ecx], 0
 00000284  74 03		    je   CheckLength
 00000286  41			    inc  ecx
 00000287  EB F7		    jmp  CountLength

 00000289			CheckLength:
 00000289  83 F9 10		    cmp  ecx, 16
 0000028C  75 3B		    jne  ParseFailed

 0000028E  33 C9		    xor  ecx, ecx

 00000290			ConvertByteLoop:
 00000290  83 F9 08		    cmp  ecx, 8
 00000293  7D 2D		    jge  ParseSuccess

				    ; แปลง Nibble บน
 00000295  0F B6 06		    movzx eax, BYTE PTR [esi]
 00000298  50			    push eax
 00000299  E8 00000038		    call HexCharToValue
 0000029E  83 F8 FF		    cmp  eax, -1
 000002A1  74 26		    je   ParseFailed
 000002A3  C1 E0 04		    shl  eax, 4
 000002A6  8B D8		    mov  ebx, eax

				    ; แปลง Nibble ล่าง
 000002A8  0F B6 46 01		    movzx eax, BYTE PTR [esi + 1]
 000002AC  50			    push eax
 000002AD  E8 00000024		    call HexCharToValue
 000002B2  83 F8 FF		    cmp  eax, -1
 000002B5  74 12		    je   ParseFailed
 000002B7  0B D8		    or   ebx, eax

 000002B9  88 1C 0F		    mov  BYTE PTR [edi + ecx], bl
 000002BC  83 C6 02		    add  esi, 2
 000002BF  41			    inc  ecx
 000002C0  EB CE		    jmp  ConvertByteLoop

 000002C2			ParseSuccess:
 000002C2  B8 00000001		    mov  eax, 1
 000002C7  EB 02		    jmp  ParseReturn

 000002C9			ParseFailed:
 000002C9  33 C0		    xor  eax, eax

 000002CB			ParseReturn:
 000002CB  5F			    pop  edi
 000002CC  5E			    pop  esi
 000002CD  5A			    pop  edx
 000002CE  59			    pop  ecx
 000002CF  5B			    pop  ebx
 000002D0  8B E5		    mov  esp, ebp
 000002D2  5D			    pop  ebp
 000002D3  C2 0008		    ret  8
 000002D6			ParseAndConvertHex ENDP


				; =========================================================================
				; HexCharToValue
				; แปลง ASCII Character เป็นตัวเลขฐานสิบหก (0-15)
				; =========================================================================
 000002D6			HexCharToValue PROC
 000002D6  55			    push ebp
 000002D7  8B EC		    mov  ebp, esp

 000002D9  8B 45 08		    mov  eax, [ebp + 8]

 000002DC  3C 30		    cmp  al, '0'
 000002DE  72 0B		    jb   CheckUpper
 000002E0  3C 39		    cmp  al, '9'
 000002E2  77 07		    ja   CheckUpper
 000002E4  2C 30		    sub  al, '0'
 000002E6  0F B6 C0		    movzx eax, al
 000002E9  EB 27		    jmp  HexCharDone

 000002EB			CheckUpper:
 000002EB  3C 41		    cmp  al, 'A'
 000002ED  72 0D		    jb   CheckLower
 000002EF  3C 46		    cmp  al, 'F'
 000002F1  77 09		    ja   CheckLower
 000002F3  2C 41		    sub  al, 'A'
 000002F5  04 0A		    add  al, 10
 000002F7  0F B6 C0		    movzx eax, al
 000002FA  EB 16		    jmp  HexCharDone

 000002FC			CheckLower:
 000002FC  3C 61		    cmp  al, 'a'
 000002FE  72 0D		    jb   InvalidHexChar
 00000300  3C 66		    cmp  al, 'f'
 00000302  77 09		    ja   InvalidHexChar
 00000304  2C 61		    sub  al, 'a'
 00000306  04 0A		    add  al, 10
 00000308  0F B6 C0		    movzx eax, al
 0000030B  EB 05		    jmp  HexCharDone

 0000030D			InvalidHexChar:
 0000030D  B8 FFFFFFFF		    mov  eax, -1

 00000312			HexCharDone:
 00000312  8B E5		    mov  esp, ebp
 00000314  5D			    pop  ebp
 00000315  C2 0004		    ret  4
 00000318			HexCharToValue ENDP


				; =========================================================================
				; PrintHexByte (เขียนขึ้นทดแทน WriteHexB ที่ไม่มีใน Irvine32)
				; พิมพ์ค่าใน AL ออกหน้าจอเป็นเลขฐาน 16 จำนวน 2 หลักเสมอ
				; =========================================================================
 00000318			PrintHexByte PROC
 00000318  50			    push eax
 00000319  53			    push ebx

 0000031A  8A D8		    mov  bl, al                ; สำรองค่าเดิม

				    ; พิมพ์ Upper Nibble
 0000031C  C0 E8 04		    shr  al, 4
 0000031F  3C 09		    cmp  al, 9
 00000321  76 04		    jbe  DigitUpper
 00000323  04 37		    add  al, 'A' - 10
 00000325  EB 02		    jmp  PrintUpper
 00000327			DigitUpper:
 00000327  04 30		    add  al, '0'
 00000329			PrintUpper:
 00000329  E8 00000000 E	    call WriteChar

				    ; พิมพ์ Lower Nibble
 0000032E  8A C3		    mov  al, bl
 00000330  24 0F		    and  al, 0Fh
 00000332  3C 09		    cmp  al, 9
 00000334  76 04		    jbe  DigitLower
 00000336  04 37		    add  al, 'A' - 10
 00000338  EB 02		    jmp  PrintLower
 0000033A			DigitLower:
 0000033A  04 30		    add  al, '0'
 0000033C			PrintLower:
 0000033C  E8 00000000 E	    call WriteChar

 00000341  5B			    pop  ebx
 00000342  58			    pop  eax
 00000343  C3			    ret
 00000344			PrintHexByte ENDP


				; =========================================================================
				; DisplayAllSubKeys
				; แสดงค่า C0, D0 เริ่มต้น และแสดง Subkeys K1 ถึง K16 ขนาด 48 บิต
				; Parameters: [ebp + 8] = Pointer ไปยัง Buffer Subkeys 96 ไบต์
				; =========================================================================
 00000344			DisplayAllSubKeys PROC
 00000344  55			    push ebp
 00000345  8B EC		    mov  ebp, esp
 00000347  60			    pushad

 00000348  8B 75 08		    mov  esi, [ebp + 8]

				    ; 1. แสดงค่าเริ่มต้น C0 และ D0 ดั้งเดิม
 0000034B  E8 00000000 E	    call Crlf
 00000350  BA 00000126 R	    mov  edx, OFFSET msgC0D0
 00000355  E8 00000000 E	    call WriteString
 0000035A  A1 000001F7 R	    mov  eax, C0_Init
 0000035F  E8 00000000 E	    call WriteHex

 00000364  BA 00000136 R	    mov  edx, OFFSET msgD0
 00000369  E8 00000000 E	    call WriteString
 0000036E  A1 000001FB R	    mov  eax, D0_Init
 00000373  E8 00000000 E	    call WriteHex
 00000378  E8 00000000 E	    call Crlf
 0000037D  E8 00000000 E	    call Crlf

				    ; 2. แสดง K1 - K16 (48-bit ในแต่ละรอบ)
 00000382  33 C9		    xor  ecx, ecx

 00000384			DisplayRoundLoop:
 00000384  83 F9 10		    cmp  ecx, 16
 00000387  7D 4A		    jge  DisplayDone

 00000389  BA 00000140 R	    mov  edx, OFFSET msgRoundPrefix
 0000038E  E8 00000000 E	    call WriteString
 00000393  8B C1		    mov  eax, ecx
 00000395  40			    inc  eax
 00000396  E8 00000000 E	    call WriteDec

				    ; จัด Format ย่อหน้า K1 ถึง K9 ให้ตรงกับ K10 ถึง K16
 0000039B  83 F8 0A		    cmp  eax, 10
 0000039E  73 07		    jae  SkipSpacePad
 000003A0  B0 20		    mov  al, ' '
 000003A2  E8 00000000 E	    call WriteChar

 000003A7			SkipSpacePad:
 000003A7  BA 00000142 R	    mov  edx, OFFSET msgColon
 000003AC  E8 00000000 E	    call WriteString

				    ; คำนวณ Pointer ของรอบปัจจุบัน: esi + (round * 6)
 000003B1  8B C1		    mov  eax, ecx
 000003B3  6B C0 06		    imul eax, 6
 000003B6  8D 1C 06		    lea  ebx, [esi + eax]

				    ; พิมพ์ 6 ไบต์ (12 Hex digits)
 000003B9  33 D2		    xor  edx, edx
 000003BB			PrintBytesLoop:
 000003BB  83 FA 06		    cmp  edx, 6
 000003BE  7D 0B		    jge  PrintBytesDone
 000003C0  8A 04 13		    mov  al, BYTE PTR [ebx + edx]
 000003C3  E8 FFFFFF50		    call PrintHexByte
 000003C8  42			    inc  edx
 000003C9  EB F0		    jmp  PrintBytesLoop

 000003CB			PrintBytesDone:
 000003CB  E8 00000000 E	    call Crlf
 000003D0  41			    inc  ecx
 000003D1  EB B1		    jmp  DisplayRoundLoop

 000003D3			DisplayDone:
 000003D3  E8 00000000 E	    call Crlf
 000003D8  61			    popad
 000003D9  8B E5		    mov  esp, ebp
 000003DB  5D			    pop  ebp
 000003DC  C2 0004		    ret  4
 000003DF			DisplayAllSubKeys ENDP

				END main
