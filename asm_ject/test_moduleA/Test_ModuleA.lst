				; ============================================================
				; SkipSpaces
				; ============================================================

 00000420			SkipSpaces PROC

 00000420			SkipSpacesLoop:

 00000420  8A 06		    mov al, BYTE PTR [esi]

 00000422  3C 20		    cmp al, ' '

 00000424  75 03		    jne SkipSpacesDone

 00000426  46			    inc esi

 00000427  EB F7		    jmp SkipSpacesLoop


 00000429			SkipSpacesDone:

 00000429  C3			    ret

 0000042A			SkipSpaces ENDP


				; ============================================================
				; MatchWord
				; ============================================================

 0000042A			MatchWord PROC

 0000042A  53			    push ebx
 0000042B  52			    push edx


 0000042C  8B D6		    mov edx, esi


 0000042E			MatchLoop:

 0000042E  8A 06		    mov al, BYTE PTR [esi]

 00000430  8A 1F		    mov bl, BYTE PTR [edi]


 00000432  80 FB 00		    cmp bl, 0

 00000435  74 08		    je CheckWordEnd


 00000437  3A C3		    cmp al, bl

 00000439  75 16		    jne WordNotMatch


 0000043B  46			    inc esi
 0000043C  47			    inc edi

 0000043D  EB EF		    jmp MatchLoop


 0000043F			CheckWordEnd:

 0000043F  3C 00		    cmp al, 0

 00000441  74 06		    je WordMatch


 00000443  3C 20		    cmp al, ' '

 00000445  74 02		    je WordMatch


 00000447  EB 08		    jmp WordNotMatch


 00000449			WordMatch:

 00000449  B8 00000001		    mov eax, 1

 0000044E  5A			    pop edx
 0000044F  5B			    pop ebx

 00000450  C3			    ret


 00000451			WordNotMatch:

 00000451  8B F2		    mov esi, edx

 00000453  B8 00000000		    mov eax, 0

 00000458  5A			    pop edx
 00000459  5B			    pop ebx

 0000045A  C3			    ret

 0000045B			MatchWord ENDP


				; ============================================================
				; EnsureEndOfLine
				; Return: EAX = 1 (Clean End), EAX = 0 (Junk trailing characters)
				; ============================================================

 0000045B			EnsureEndOfLine PROC

 0000045B  E8 FFFFFFC0		    call SkipSpaces

 00000460  8A 06		    mov al, BYTE PTR [esi]

 00000462  3C 00		    cmp al, 0
 00000464  75 06		    jne EOL_Fail

 00000466  B8 00000001		    mov eax, 1
 0000046B  C3			    ret

 0000046C			EOL_Fail:

 0000046C  B8 00000000		    mov eax, 0
 00000471  C3			    ret

 00000472			EnsureEndOfLine ENDP


				; ============================================================
				; CopyToken
				; Return: EAX = 1 (Success), EAX = 0 (Empty)
				; ============================================================

 00000472			CopyToken PROC

 00000472  53			    push ebx
 00000473  BB 00000000		    mov ebx, 0

 00000478			CopyTokenLoop:

 00000478  83 F9 00		    cmp ecx, 0
 0000047B  74 12		    je CopyTokenCheck

 0000047D  8A 06		    mov al, BYTE PTR [esi]

 0000047F  3C 00		    cmp al, 0
 00000481  74 0C		    je CopyTokenCheck

 00000483  3C 20		    cmp al, ' '
 00000485  74 08		    je CopyTokenCheck

 00000487  88 07		    mov BYTE PTR [edi], al

 00000489  46			    inc esi
 0000048A  47			    inc edi
 0000048B  43			    inc ebx
 0000048C  49			    dec ecx

 0000048D  EB E9		    jmp CopyTokenLoop

 0000048F			CopyTokenCheck:

 0000048F  C6 07 00		    mov BYTE PTR [edi], 0

 00000492  83 FB 00		    cmp ebx, 0
 00000495  74 07		    je CopyTokenFail

 00000497  B8 00000001		    mov eax, 1
 0000049C  5B			    pop ebx
 0000049D  C3			    ret

 0000049E			CopyTokenFail:

 0000049E  B8 00000000		    mov eax, 0
 000004A3  5B			    pop ebx
 000004A4  C3			    ret

 000004A5			CopyToken ENDP


				; ============================================================
				; CopyQuotedString
				; Expected format: "filename.txt"
				; Return: EAX = 1 (Success), EAX = 0 (Invalid Syntax/Empty)
				; ============================================================

 000004A5			CopyQuotedString PROC

 000004A5  E8 FFFFFF76		    call SkipSpaces

 000004AA  8A 06		    mov al, BYTE PTR [esi]
 000004AC  3C 22		    cmp al, '"'
 000004AE  75 28		    jne QuotedFail

 000004B0  46			    inc esi
 000004B1  57			    push edi

 000004B2			CopyQuotedLoop:

 000004B2  83 F9 00		    cmp ecx, 0
 000004B5  74 20		    je QuotedFailPop

 000004B7  8A 06		    mov al, BYTE PTR [esi]

 000004B9  3C 00		    cmp al, 0
 000004BB  74 1A		    je QuotedFailPop

 000004BD  3C 22		    cmp al, '"'
 000004BF  74 07		    je QuotedClose

 000004C1  88 07		    mov BYTE PTR [edi], al

 000004C3  46			    inc esi
 000004C4  47			    inc edi
 000004C5  49			    dec ecx

 000004C6  EB EA		    jmp CopyQuotedLoop

 000004C8			QuotedClose:

 000004C8  C6 07 00		    mov BYTE PTR [edi], 0
 000004CB  46			    inc esi

 000004CC  5B			    pop ebx
 000004CD  3B FB		    cmp edi, ebx
 000004CF  74 07		    je QuotedFail

 000004D1  B8 00000001		    mov eax, 1
 000004D6  C3			    ret

 000004D7			QuotedFailPop:

 000004D7  5B			    pop ebx

 000004D8			QuotedFail:

 000004D8  C6 07 00		    mov BYTE PTR [edi], 0
 000004DB  B8 00000000		    mov eax, 0
 000004E0  C3			    ret

 000004E1			CopyQuotedString ENDP


				; ============================================================
				; ValidateHexKey
				; Checks if keyString is a valid 64-bit Hex key (16 hex chars / 0x prefix)
				; Return: EAX = 1 (Valid), EAX = 0 (Invalid)
				; ============================================================

 000004E1			ValidateHexKey PROC

 000004E1  53			    push ebx
 000004E2  51			    push ecx
 000004E3  52			    push edx
 000004E4  56			    push esi

 000004E5  8A 06		    mov al, BYTE PTR [esi]
 000004E7  3C 30		    cmp al, '0'
 000004E9  75 0E		    jne CheckLoopStart

 000004EB  8A 46 01		    mov al, BYTE PTR [esi + 1]
 000004EE  3C 78		    cmp al, 'x'
 000004F0  74 04		    je SkipPrefix
 000004F2  3C 58		    cmp al, 'X'
 000004F4  75 03		    jne CheckLoopStart

 000004F6			SkipPrefix:

 000004F6  83 C6 02		    add esi, 2

 000004F9			CheckLoopStart:

 000004F9  B9 00000000		    mov ecx, 0


 000004FE			ValHexLoop:

 000004FE  8A 06		    mov al, BYTE PTR [esi]

 00000500  3C 00		    cmp al, 0
 00000502  74 1C		    je ValHexDone


 00000504  3C 30		    cmp al, '0'
 00000506  72 04		    jb CheckUpper
 00000508  3C 39		    cmp al, '9'
 0000050A  76 10		    jbe ValidChar


 0000050C			CheckUpper:

 0000050C  3C 41		    cmp al, 'A'
 0000050E  72 04		    jb CheckLower
 00000510  3C 46		    cmp al, 'F'
 00000512  76 08		    jbe ValidChar


 00000514			CheckLower:

 00000514  3C 61		    cmp al, 'a'
 00000516  72 14		    jb ValHexFail
 00000518  3C 66		    cmp al, 'f'
 0000051A  77 10		    ja ValHexFail


 0000051C			ValidChar:

 0000051C  41			    inc ecx
 0000051D  46			    inc esi
 0000051E  EB DE		    jmp ValHexLoop


 00000520			ValHexDone:

 00000520  83 F9 10		    cmp ecx, 16
 00000523  75 07		    jne ValHexFail

 00000525  B8 00000001		    mov eax, 1
 0000052A  EB 05		    jmp ValHexExit


 0000052C			ValHexFail:

 0000052C  B8 00000000		    mov eax, 0


 00000531			ValHexExit:

 00000531  5E			    pop esi
 00000532  5A			    pop edx
 00000533  59			    pop ecx
 00000534  5B			    pop ebx

 00000535  C3			    ret

 00000536			ValidateHexKey ENDP


				END main
